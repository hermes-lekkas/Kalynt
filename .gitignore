# Dependencies
node_modules/
.agents/skills/
/video

# GitHub directory (allowlist tracked hooks, workflows, and issue templates)
.github/*
!.github/ISSUE_TEMPLATE/
!.github/ISSUE_TEMPLATE/**
!.github/hooks/
!.github/hooks/**
!.github/workflows/
.github/workflows/*
!.github/workflows/build.yml
!.github/workflows/pages.yml
!.github/workflows/verify.yml

# Build outputs
/dist/
/build/
/dist-electron/
/release/
/packages/*/dist
/apps/*/dist
/apps/*/dist-electron
/apps/*/release
*.tsbuildinfo

# Logs
*.log
*.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temp/Misc
.eslintrc.json
eslint-report.json
snyk_report.json
.vercel
.turbo

# Environment
.env
.env.local
.env.*.local

# IDE & Agent tooling
.vscode/
.idea/
.claude/
.gemini/
.kilocodemodes
.agent/rules/snyk_rules.md
.codesight/scan_configs/
SKILL.md
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Private Keys - NEVER commit these!
deploy_key
deploy_key.pub
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
ssh_key*
.ssh/
gha-creds-*.json

# Internal Scripts
/scripts/*
!/scripts/install-security-hooks.sh

# Root HTML & Documentation allowlist
!index.html
*.md
!/docs/adoption/*.md
!README.MD
!SECURITY.md
