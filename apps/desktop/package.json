{
    "name": "@kalynt/desktop",
    "version": "2.0.0",
    "private": true,
    "productName": "Kalynt",
    "author": {
        "name": "Hermes Lekkas",
        "email": "hermeslekkasdev@gmail.com"
    },
    "homepage": "https://github.com/Hermes-Lekkas/Kalynt",
    "description": "Kalynt Desktop Application",
    "main": "dist-electron/main.js",
    "scripts": {
        "test": "node scripts/test.cjs",
        "test:smoke": "electron scripts/smoke.cjs",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "typecheck:fixtures": "tsc --noEmit -p tsconfig.fixtures.json",
        "dev": "vite",
        "dev:web": "vite --config vite.config.web.ts",
        "build": "npm run typecheck && vite build && electron-builder",
        "build:vite": "npm run typecheck && vite build",
        "build:prod": "cross-env NODE_ENV=production npm run typecheck && cross-env NODE_ENV=production vite build && electron-builder",
        "build:secure": "cross-env NODE_ENV=production npm run typecheck && cross-env NODE_ENV=production vite build && electron-builder",
        "preview": "vite preview",
        "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --no-sandbox\"",
        "electron:dev:linux": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --no-sandbox --ozone-platform-hint=auto\"",
        "electron:build": "vite build && electron-builder",
        "electron:build:secure": "cross-env NODE_ENV=production vite build && electron-builder"
    },
    "dependencies": {
        "chokidar": "^3.6.0",
        "electron-updater": "^6.7.3",
        "node-llama-cpp": "^3.15.0",
        "node-pty": "^1.1.0",
        "simple-git": "^3.30.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "^0.135.0",
        "@fontsource-variable/instrument-sans": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@monaco-editor/react": "^4.7.0",
        "@types/path-browserify": "^1.0.3",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/uuid": "^9.0.0",
        "@vitejs/plugin-react": "^4.2.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-search": "^0.16.0",
        "@xterm/addon-unicode11": "^0.9.0",
        "@xterm/addon-web-links": "^0.12.0",
        "@xterm/xterm": "^6.0.0",
        "concurrently": "^8.2.0",
        "cross-env": "^10.1.0",
        "electron": "^40.6.1",
        "electron-builder": "^25.1.8",
        "extract-zip": "^2.0.1",
        "fuse.js": "^7.1.0",
        "lucide-react": "^0.562.0",
        "monaco-editor": "^0.52.2",
        "path-browserify": "^1.0.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-test-renderer": "^18.3.1",
        "terser": "^5.46.0",
        "tree-kill": "^1.2.2",
        "ts-node": "^10.9.2",
        "typescript": "5.7.3",
        "uuid": "^9.0.0",
        "vite": "^7.3.1",
        "vite-plugin-electron": "^0.29.0",
        "vite-plugin-electron-renderer": "^0.14.0",
        "vscode-languageserver-protocol": "^3.17.5",
        "wait-on": "^7.2.0",
        "web-tree-sitter": "^0.26.5",
        "y-indexeddb": "^9.0.0",
        "y-webrtc": "^10.3.0",
        "yjs": "^13.6.0",
        "zustand": "^4.4.0"
    },
    "overrides": {
        "ajv": "^6.12.5",
        "ajv-keywords": "^3.5.2"
    },
    "build": {
        "appId": "com.kalynt.app",
        "productName": "Kalynt",
        "electronVersion": "40.6.1",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "!node_modules/node-llama-cpp/**/*",
            "!node_modules/@node-llama-cpp/**/*"
        ],
        "afterPack": "scripts/after-pack.cjs",
        "asarUnpack": [
            "node_modules/node-pty/**/*",
            "**/*.node"
        ],
        "extraResources": [
            {
                "from": "../../node_modules/node-llama-cpp",
                "to": "node_modules/node-llama-cpp",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../../node_modules/@node-llama-cpp",
                "to": "node_modules/@node-llama-cpp",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "publish": {
            "provider": "github",
            "owner": "Hermes-Lekkas",
            "repo": "Kalynt",
            "private": false,
            "releaseType": "release"
        },
        "win": {
            "icon": "public/Kalynt_256x256.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "publisherName": "Hermes Lekkas",
            "verifyUpdateCodeSignature": false
        },
        "mac": {
            "icon": "public/Kalynt.png",
            "target": [
                "dmg"
            ],
            "artifactName": "${productName}-${version}.${ext}",
            "category": "public.app-category.developer-tools",
            "hardenedRuntime": true,
            "gatekeeperAssess": false
        },
        "linux": {
            "icon": "public/Kalynt.png",
            "executableName": "kalynt",
            "target": [
                "AppImage",
                "deb"
            ],
            "artifactName": "${productName}-${version}.${ext}",
            "category": "Development"
        }
    }
}
